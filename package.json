{
  "name": "fuzzytable",
  "type": "module",
  "version": "0.2.2",
  "description": "A JavaScript module to render and manage a dynamic data table with sorting, filtering, and pagination.",
  "main": "./dist/FuzzyTable.min.js",
  "module": "./dist/FuzzyTable.min.js",
  "svelte": "./src/FuzzyTable.svelte",
  "types": "./src/FuzzyTable.d.ts",
  "exports": {
    ".": {
      "types": "./src/FuzzyTable.d.ts",
      "import": "./dist/FuzzyTable.min.js",
      "require": "./dist/FuzzyTable.min.umd.cjs"
    },
    "./svelte": {
      "types": "./src/FuzzyTable.d.ts",
      "svelte": "./src/FuzzyTable.svelte"
    },
    "./style.css": "./dist/FuzzyTable.min.css"
  },
  "files": [
    "dist",
    "src/FuzzyTable.svelte",
    "src/FuzzyTable.d.ts",
    "src/FuzzyTable.js",
    "src/FuzzyTableHelper.js",
    "src/FuzzyTableBody.js",
    "src/FuzzyTableFilters.js",
    "src/FuzzyTableSort.js",
    "src/FuzzyTableSearch.js",
    "src/FuzzyTablePagination.js",
    "src/FuzzyTableSizeSelect.js",
    "src/FuzzyTableDownloader.js",
    "src/FuzzyTableStyles.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "data-table",
    "filter",
    "sort",
    "pagination"
  ],
  "author": "Jon Bitgood",
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "rollup": "^2.79.1",
    "rollup-plugin-terser": "^7.0.2",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.1.4",
    "vite": "^6.2.6"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.4"
  }
}